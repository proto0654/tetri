# Local env for demo:pull / demo:push (copy to .env.deploy — never commit .env.deploy)
# Production defaults after cutover; for pulling from an old host override --host/--user/--path/--key.

DEPLOY_HOST=<DEPLOY_HOST>
DEPLOY_USER=<DEPLOY_USER>
DEPLOY_PATH=www/tetri-cafe.ru/
DEPLOY_SSH_KEY=
DEPLOY_PHP=/opt/php/8.4/bin/php
